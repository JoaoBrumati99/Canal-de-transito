MAILERSEND_API_TOKEN=replace_with_your_mailersend_api_token
EMAIL_FROM=sender@example.com
RECEBEEMAIL=recipient@example.com
EMAIL_TEST_TO=recipient@example.com
FRONTEND_ORIGIN=https://canal-de-transito-amalfis.vercel.app

# Geoapify Reverse Geocoding API. Keep disabled until a key is configured
# and you intentionally approve sending coordinates to Geoapify.
GEOAPIFY_API_KEY=
GEOAPIFY_ENABLED=true
GEOAPIFY_RATE_LIMIT_PER_MINUTE=10
GEOAPIFY_MAX_CONCURRENT=2